# ==================================================================
#  ПАСПОРТ ИГРЫ «КАПИТАНЫ ОСТРОВОВ» (морской бой)
#  Форма: DSL — структурированный текст, читается и человеком,
#  и любой нейросетью (по нему можно построить игру заново).
#  Версия игры: 6 (мета app-version) · офлайн-движок captains-cache-v7
#  Версия паспорта: 1.0  ·  Дата: 13.11.2026
#  Составлен по фактическому коду GitHub-версии — она объявлена
#  главной решением заказчика 13.11.2026 (в ней есть игра по сети),
#  а не по памяти.
#
#  Правила чтения:
#    блок { ... }        — раздел
#    ключ: значение      — свойство
#    [ "a", "b" ]        — список
#    статусы: ГОТОВО / В РАБОТЕ / В ПЛАНЕ / ИДЕЯ / ОБСУДИТЬ
# ==================================================================


# ------------------------------ 1. КАРТОЧКА ИГРЫ ------------------------------

карточка {
  название    : "Капитаны островов"
  жанр        : "семейный морской бой: классика + карты-бонусы и игра по сети"
  версия      : "6 (в меню: «Версия игры: 6»; сетевой режим добавлен поверх v6 и номер не менял)"
  платформа   : "один HTML-файл (index.html) — телефон, планшет, компьютер, любой браузер; PWA (офлайн + установка на главный экран) работала на родном хостинге, на GitHub пока отключена (раздел 10)"
  аудитория   : "семья: дети и взрослые, дуэль 1 на 1; партия 5–15 минут"
  язык        : "русский — весь интерфейс и подсказки"
  режимы      : [
    "против компьютера: лёгкий / средний / сложный",
    "вдвоём на одном устройстве (передача хода баннером)",
    "играть по сети: код комнаты (PeerJS, интернет у обоих)",
  ]
  масштаб     : { полей: 2 (6×6 и 8×8), карт_бонусов: 5, уровней_бота: 3 }
  принципы    : [
    "открыл страницу — играешь: без регистрации, входа и серверных аккаунтов",
    "бот ходит по тем же правилам, что и человек: одна и та же модель боя, без подглядываний",
    "вместо голого «попал — мазнул» — тактика: разведка, защита, маскировка, суперуар",
    "корабли рисуются с характером: башни, трубы, мачты, флаги, носовые буруны",
    "прогресс боевой серии хранится на устройстве — счёт «Аня 2 : 0 Папа» не теряется",
    "свободный доступ: игра живёт на постоянном бесплатном адресе GitHub Pages (раздел 10)",
  ]
}


# ------------------------------ 2. ТЕХНОЛОГИИ ------------------------------

технологии {
  каркас    : "одиночный файл HTML + CSS + JS (vanilla), без сборки и без своих зависимостей"
  отрисовка : "доски и эффекты — <canvas>: море, острова, корабли, снаряды, торпеды, перископы, лучи радара рисуются кодом"
  корабли   : "детализированные: корпус с острым носом, орудийные башни, трубы, мачта, рубка, флаг, носовые буруны; Флагман / Крейсер / Катер различаются силуэтом и числом башен"
  сеть      : "PeerJS 1.5.2 с CDN jsdelivr — комнаты по коду, соединение браузер↔браузер (WebRTC)"
  звук      : "синтез WebAudio прямо в браузере, ни одного аудиофайла"
  хранение  : "localStorage устройства: ci:save — партия в разгаре, ci:score — счёт побед и серия"
  pwa       : "service worker captains-sw.js (кэш captains-cache-v7) + captains.webmanifest + иконки 192/512/maskable; проверка обновления: meta app-version сверяется с версией в captains-sw.js, кнопка «🔄 Обновить игру»"
  мобильное : "крупные клетки, панель под полем, безопасные зоны iPhone, защита от случайного зума; проверено на 390×844 и 1280×800"
}


# ------------------------------ 3. ЭКРАНЫ ------------------------------

экраны {
  меню {
    шапка      : "чип режима «Локальная игра» + кнопки: ⚙ оформление · 🔊 звук · ? правила"
    продолжить { когда: "есть незаконченная партия (ci:save)", кнопка: "↩ Продолжить партию" }
    обновление { плашка: "«🎮 Вышло обновление игры — нажми, чтобы установить» появляется, когда проверка увидела новую версию", кнопка_низ: "🔄 Обновить игру — ручная проверка версии" }
    соперник   : [ "Компьютер · лёгкий", "Компьютер · средний", "Компьютер · сложный", "Вдвоём на устройстве" ]
    поле       : "переключатель: Простой 6×6 / Сложный 8×8"
    имена      : "два поля ввода (до 14 символов), по умолчанию «Капитан 1» и «Капитан 2»"
    кнопки     : [ "⚓ В бой", "🌐 Играть по сети", "🔄 Обновить игру" ]
    низ        : "строка «Версия игры: 6»"
  }

  расстановка {
    доска      : "своё море с островами"
    управление : "корабли тянутся пальцем/мышью, «Повернуть» меняет ориентацию"
    кнопки     : [ "Повернуть", "Расставить за меня", "Убрать всё", "Готов" ]
    запреты    : "корабли не касаются друг друга даже углом и не ставятся на острова"
  }

  выбор_карт {
    суть       : "каждый капитан тайно выбирает 3 карты из 5 (состав карт — раздел 5); при передаче устройства чужой выбор не виден"
  }

  бой {
    вкладки    : [ "Противник — вражеское море с выстрелами", "Мой флот — свои корабли и статус щита («щит не стоит» / клетка)" ]
    рука_карт  : "3 карты внизу; выбор боевой карты включает прицеливание, щит/стелс — действие по своей доске"
    прицел     : "подсказка + кнопки «Огонь» / «Отмена»; у торпеды — стрелки направления (вверх/вниз/влево/вправо) и перископ, показывающий, куда полетит"
    баннер     : "сообщения: «Выбери клетку и подтверди выстрел», результат хода, «Передайте устройство»"
    автосмена_доски { сейчас: "при выборе боевой карты доска сама перескакивает на противника, при ходе соперника — на свою; это неудобно заказчику — правка №2 в разделе 12" }
    передача   : "в дуэли на одном устройстве баннер «Передайте устройство» + кнопка «Я готов» — чужие корабли не подсмотреть"
    счёт       : "чип серии «Аня 2 : 0 Папа» — виден в бою и на итогах"
  }

  итог {
    окно       : "кто победил, счёт пары имён, серия побед и медаль, фейерверк в видимых зонах экрана"
    кнопки     : [ "Реванш", "В меню" ]
  }

  настройки_оформления {
    вход       : "кнопка ⚙ из меню"
    пункты     : [ "Волнение моря", "Пузырьки", "Свечение лучей", "Размер клеток", "Координаты на поле", "Анимации эффектов", "Качество картинки" ]
    сброс      : "кнопка «Сбросить оформление»"
    звук       : "кнопка 🔊 глушит/включает все эффекты"
  }
}


# ------------------------------ 4. ПРАВИЛА БОЯ ------------------------------

правила {
  поля [
    { режим: "Простой", сетка: "6×6", флот: "3–2–2: Крейсер, Катер, Катер", острова: 2, радар: "область 2×2", подпись: "крупные клетки — хорошо младшим" },
    { режим: "Сложный", сетка: "8×8", флот: "4–3–2–2: Флагман, Крейсер, Катер, Катер", острова: 4, радар: "область 3×3" },
  ]

  корабли   { имена: "4 клетки — Флагман · 3 — Крейсер · 2 — Катер", правило: "не касаются друг друга даже углом, на острова не ставятся" }
  острова   : "скалы в море: по ним стрелять нельзя, на них корабли не ставятся, радар и эхолот их воду не считают"

  ход       : "ход = действие (карта по желанию) + выстрел; ПОСЛЕ ЛЮБОГО действия ход переходит сопернику — даже после попадания; серия возможна только у торпеды, которая бьёт несколько кораблей подряд"
  повтор    : "стрелять в клетку, которая уже проверена, нельзя («Эта клетка уже проверена»)"
  победа    : "побеждает капитан, потопивший весь флот соперника; тонущий корабль показывается по остальным клеткам с дымом на мачтах"
  нюанс_щита: "в модели корабль, все целые клетки которого стоят под щитом, считается потопленным, а щитовые клетки не видны разведке — так щит реально спасает корабль до конца партии (смотровая правка №1 в разделе 12)"
  честность : "бот играет через ту же модель и те же карты, что и человек"
}


# ------------------------------ 5. КАРТЫ-БОНУСЫ ------------------------------

карты {
  выдача    : "на бой каждый капитан выбирает 3 карты из 5; каждая карта срабатывает 1 раз за партию"
  радар     { действие: "показывает квадрат 2×2 (6×6) или 3×3 (8×8): сколько живых клеток флота в воде; область должна целиком влезть в поле" }
  эхолот    { действие: "считает живые клетки флота по целой строке или целому столбцу" }
  щит       { действие: "ставится на здоровую клетку своего корабля; выстрел соперника по этой клетке гасится («blocked») со вспышкой золотого купола и не наносит повреждения", описание_в_игре: "«Защищает клетку корабля весь бой. Выстрелы по ней гасятся.»" }
  торпеда   { действие: "плывёт от выбранной клетки до края поля по прямой (4 направления), бьёт первый встреченный необработанный корабль и все корабли дальше по пути — возможна серия потоплений" }
  стелс     { действие: "соперник не может использовать радар и эхолот в свой следующий ход (один ход без разведки)" }
  бот_выбор { лёгкий: [радар, щит, эхолот], средний: [радар, щит, торпеда], сложный: [торпеда, щит, радар] }
}


# ------------------------------ 6. ИГРА ПО СЕТИ ------------------------------

сеть {
  движок    : "PeerJS 1.5.2 (CDN jsdelivr) — соединение напрямую между браузерами, сервер только «знакомит»"
  хост      : "кнопка «Создать игру (Я хост)» → игра показывает короткий код комнаты крупными буквами"
  гость     : "вводит код друга → «Подключиться» — ждёт соединения"
  синхрон   : "каждое действие (выстрел, карта) уходит сопернику и применяется у него так же, как у автора (applyAction с пометкой «remote»)"
  условия   : "интернет нужен обоим; сворачивание вкладки не рвёт партию — соединение переподхватывается"
  против_кого: "любой капитан может быть и ботом-хостом: второй телефон подключается кодом — удобно «дома–даче»"
}


# ------------------------------ 7. СОХРАНЕНИЕ ------------------------------

сохранение {
  хранилище : "localStorage устройства; сервер ничего не хранит"
  ключи {
    партия  : { ключ: "ci:save", содержимое: "полная модель боя + кто сейчас смотрит на доску; кнопка «↩ Продолжить партию»" }
    счёт    : { ключ: "ci:score", содержимое: "names (два имени), wins (победы каждого), streak (серия и её владелец) — чип «Аня 2 : 0 Папа» и медаль серии" }
  }
  очистка   : "ci:save стирается при победе (итог показан) и при выходе в меню"
  сброс_счёта: "при смене имён счёт начинается заново — счёт привязан к паре имён"
}


# ------------------------------ 8. ЗВУК И ЭФФЕКТЫ ------------------------------

звук_и_эффекты {
  звуки [
    { имя: "shoot",   когда: "выстрел" },
    { имя: "splash",  когда: "промах (белый всплеск)" },
    { имя: "hit",     когда: "попадание (розовый всплеск)" },
    { имя: "sunk",    когда: "корабль потоплен" },
    { имя: "blocked", когда: "выстрел погасил щит" },
    { имя: "torpedo", когда: "торпеда пошла" },
    { имя: "plop",    когда: "бульк — перископ ушёл под воду" },
    { имя: "shield",  когда: "щит поставлен (аккорд)" },
    { имя: "click",   когда: "нажата кнопка" },
  ]
  эффекты   : "снаряд летит по дуге, всплески, вспышка купола щита, потопление с дымом, след торпеды с перископом, вращающийся луч радара, круги эхолота, волна щита, тряска доски, фейерверк на победе"
  управление: "всё гасится кнопкой 🔊 и настройками оформления («Анимации эффектов», «Качество картинки» — для слабых телефонов)"
}


# ------------------------------ 9. БОТ ------------------------------

бот {
  уровни    : "лёгкий / средний / сложный — отличаются набором карт и прицельностью стрельбы"
  карты     : "лёгкий [радар, щит, эхолот] · средний [радар, щит, торпеда] · сложный [торпеда, щит, радар]"
  щит_бота  : "на среднем и сложном: если у соперника осталось ≤5 живых клеток и щит ещё не потрачен — с шансом 55% бот ставит щит на уцелевшую клетку своего корабля"
  правила   : "бот ходит через ту же модель, что и человек: не подглядывает расстановку, расходует карты по тем же запретам"
}


# ------------------------------ 10. ХОСТИНГ И СВОБОДНЫЙ ДОСТУП ------------------------------

# Причина появления раздела (13.11.2026): рабочая сессия нейросети кончилась —
# ссылка на игру умерла. Решение: у каждой игры семьи постоянный бесплатный адрес.

хостинг_и_доступ {
  правило_проекта: "игры семьи живут на GitHub Pages — бесплатно и навсегда; сессия нейросети кончилась, игра осталась"
  адрес_сейчас   : "https://gohsa04071988-glitch.github.io/captains-game/ (файл index.html в репозитории captains-game)"
  работает       : [
    "вся игра целиком: меню, бот, дуэль на устройстве, игра по сети",
    "адрес открыт с любого устройства в любом браузере, ничего не надо устанавливать",
  ]
  не_работает_на_github { статус: "решением заказчика 13.11.2026 — ОСТАВИТЬ КАК ЕСТЬ", список: [
    "офлайн-режим: service worker /captains-sw.js на GitHub отсутствует (404) — без интернета страница не откроется",
    "установка на главный экран: manifest /captains.webmanifest отсутствует (404)",
    "кнопка «🔄 Обновить игру»: не может проверить версию (запрос 404) и всегда отвечает «у тебя последняя»",
    "причина: внутри игры прописаны абсолютные пути «/файл», а на GitHub игра живёт в папке /captains-game/",
  ] }
  как_обновить_игру: "скачать свежий captains.html → переименовать в index.html → залить в репозиторий captains-game; адрес не меняется, игроки просто открывают страницу заново"
  страховка        : "главная GitHub-версия продублирована 13.11.2026: public/captains.html в рабочем проекте и download/game-archive/captains-v6-s-setyu-2026-11-13.html — потерять игру теперь нельзя даже при сломанном репозитории"
  паспорта         : { пазл: "download/game-passport-mir-po-kusochkam-v1.2.dsl", бой: "download/game-passport-captains-v1.0.dsl (этот файл)", суть: "по паспорту любая новая сессия нейросети восстанавливает контекст игры с нуля" }
}


