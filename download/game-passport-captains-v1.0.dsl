история_версий {
  "старт"  { статус: ГОТОВО, что: "меню, расстановка, бой, карты-бонусы, три уровня бота, победа и счёт" }
  "обновление 1" { статус: ГОТОВО, что: "анимация торпеды с входом от края поля, кораблики с парусами над картой, мачты с дымом на попаданиях, новая иконка" }
  "обновление 2" { статус: ГОТОВО, что: "круглая иконка «остров с пальмой и кораблик», maskable-иконка для Android, офлайн-движок v3" }
  "обновление 3" { статус: ГОТОВО, что: "перископ на старте торпеды, вращающийся луч радара, круги эхолота, купол щита со вспышкой при блоке, автопереход на свою доску при выстрелах соперника, звук «бульк», офлайн-движок v4" }
  "обновление 4 = v6" { статус: ГОТОВО, что: "перископ виден при прицеливании торпеды, доска сама переворачивается (боевая карта — к сопернику, щит — к себе), счёт побед с серией и медалью, фейерверк, кнопка «🔄 Обновить игру», версия 6, офлайн-движок v6" }
  "обновление 5" { статус: ГОТОВО, что: "щит ставится на клетку корабля и защищает её весь бой по правилам модели; новые корабли — корпуса с острым носом, башни, трубы, мачта, рубка, флаг, носовые буруны, Флагман/Крейсер/Катер различаются; офлайн-движок v7" }
  "сеть"   { статус: ГОТОВО, что: "игра по сети через PeerJS: код комнаты, синхронизация действий; есть только в GitHub-версии, в рабочем проекте не коммитилась (13.11.2026 зафиксировано в паспорте)" }
