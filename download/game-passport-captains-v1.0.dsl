# ------------------------------ 12. ПЛАН ПРАВОК ------------------------------

# Составлен из слов заказчика 13.11.2026. КОД НЕ ТРОГАЕМ, пока заказчик
# не скажет «начинай» — это договор по проекту.

план {
  правка "щит" { статус: В ПЛАНЕ, как_сейчас: "по ощущению заказчика щит работает один раз после активации и после попадания исчезает через ход", как_надо: "щит должен ощущаться работающим весь бой: купол постоянно виден на своей доске, каждый выстрел по клетке гасится снова, клетка не должна становиться ни «проверенной навсегда», ни доступной для попадания", примечание_кода: "в модели клетка со щитом хранится до конца боя и выстрел гасится, но погашенная клетка помечается «уже проверенной» и купол виден только на своей доске — поэтому ощущается одноразовым; точную механику повторных выстрелов согласовать при правке" }
  правка "доска" { статус: В ПЛАНЕ, как_сейчас: "при моём ходе (выборе боевой карты) доска сама перескакивает на карту противника; при ходе соперника — на мою", как_надо: "при моём ходе оставаться на СВОЕЙ карте — обдумываю, что применить; на карту противника переходить только когда сам выбрал атакующую карту или вкладку" }
  перенос_pwa { статус: ОБСУДИТЬ, суть: "починить на GitHub офлайн, установку и кнопку «Обновить» (пакет файлов с относительными путями) — заказчик 13.11.2026 решил пока оставить как есть; вернуться, когда офлайн станет нужен" }
  правило: "правки начинаются только по явной команде заказчика; после правки — новый captains.html → переименовать в index.html → залить на GitHub (раздел 10); страховочная копия — в архив проекта"
}


