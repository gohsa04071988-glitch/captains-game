  статус    : "ЧЕРНОВИК — детали обсудим, потом отдельный DSL-паспорт"
  жанр      : "детская пошаговая RPG с героями и магией в духе Heroes of Might and Magic III"
  для_кого  : "те же дети, сессия короткая — 5–10 минут"
  видение   : [
    "маленькая карта с клеточками: луга, лес, рудник, сундучки",
    "замок героя; герой ходит по карте и собирает золото и кристаллы",
    "армия из зверят: белочки-лучники, медвежата-щитоносцы",
    "маги учат заклинания: искра, лечение, щит",
    "бой по очереди и БЕЗ проигрыша: отступил, подлечился, попробовал снова",
    "без таймеров и смертей — сказка, а не стресс",
  ]
  идеи_моста: [
    "заклинания открываются за собранные пазлы «Мира по кусочкам» — две игры дружат между собой",
    "новые клетки карты открываются по мере прогулок",
    "герой приходит из собранного мира пазлов (собрал «Гонки» — в замок приехал гонщик)",
  ]
  следующий_шаг: "уточнить с вами видение и написать отдельный полный паспорт"
}



# ------------------------------ 12. ХОСТИНГ И СВОБОДНЫЙ ДОСТУП ------------------------------

# Правило проекта (13.11.2026): игры семьи живут на постоянном бесплатном адресе
# и НЕ зависят от рабочих сессий нейросети — сессия кончилась, игра осталась.

