# ==================================================================
#  ПАСПОРТ ИГРЫ «МИР ПО КУСОЧКАМ»
#  Форма: DSL — структурированный текст, читается и человеком,
#  и любой нейросетью (по нему можно построить игру заново).
#  Версия игры: 1.9  ·  Версия паспорта: 1.2  ·  Дата: 13.11.2026
#  v1.2: добавлен раздел 12 «ХОСТИНГ И СВОБОДНЫЙ ДОСТУП» — правило
#  проекта: у каждой игры семьи постоянный бесплатный адрес (GitHub Pages).
#  Составлен по фактическому коду проекта, а не по памяти.
#
#  Правила чтения:
#    блок { ... }        — раздел
#    ключ: значение      — свойство
#    [ "a", "b" ]        — список
#    статусы: ГОТОВО / В РАБОТЕ / В ПЛАНЕ / ИДЕЯ / ОБСУДИТЬ
# ==================================================================


# ------------------------------ 1. КАРТОЧКА ИГРЫ ------------------------------

карточка {
  название    : "Мир по кусочкам"
  слоган      : "Собирай · Исследуй · Удивляйся"
  девиз       : "Каждый кусочек — маленькое открытие"
  жанр        : "детская пазл-игра с озвучкой и историями"
  версия      : "1.9"
  платформа   : "веб-приложение: телефон, планшет, компьютер (любой браузер); ставится на главный экран и работает без интернета (PWA, v1.9)"
  аудитория   : "дети 3–10 лет; играть вместе со взрослым тоже удобно"
  язык        : "русский — текст и озвучка голосом"
  режим       : "одиночный; прогресс у каждого игрока свой, хранится на его устройстве (общие профили отменены)"
  масштаб     : { миров: 8, пазлов: 24, сложностей: 4, всего_сборок: 96 }
  принципы    : [
    "без таймеров и любого счёта времени",
    "без очков, рейтингов и лидербордов",
    "без штрафов и состояния «проигрыш»",
    "прогресс накопительный и только растёт",
    "все картинки рисуются кодом — ничего не может «не догрузиться»",
    "если русского голоса в устройстве нет — игра всё равно говорит дефолтным голосом, а не молчит",
  ]
}


# ------------------------------ 2. ТЕХНОЛОГИИ ------------------------------

технологии {
  каркас    : "Next.js (App Router) + TypeScript + Tailwind CSS"
  отрисовка : "процедурные сцены на <canvas>: фон + герой, ни одной картинки-файла"
  детали    : "классический джигсо с «замочками»: ушко одной детали точно совпадает с выемкой соседней"
  звук      : "синтез Web Audio прямо в браузере (никаких аудиофайлов)"
  голос     : "браузерный синтез речи SpeechSynthesis, язык ru-RU"
  хранение  : "localStorage устройства (прогресс, сессии, настройки, версия)"
  обновление: "сервер отдаёт актуальную версию (/api/version), клиент показывает плашку «Обновить»"
  вибрация  : "лёгкий отклик телефона при прилипании детали (28 мс)"
  превью    : "мини-превью в меню рисуются тем же кодом, что и игровые картинки — превью всегда совпадает с игрой"
}


# ------------------------------ 3. ЭКРАНЫ ------------------------------

экраны {
  главный {
    шапка      : "клубочек-пазл, название, слоган, девиз"
    счётчик    : "«Собрано пазлов: N из 24»"
    плашка_обновления { когда: "сервер сообщил версию новее запомненной", кнопка: "Обновить — запоминает версию и перезагружает игру" }
    кнопка_играть { вид: "большая зелёная, с кубиком", действие: "случайный несобранный пазл (сложность 6 или та, где осталась сессия); если всё собрано — следующая несобранная сложность; если собрано вообще всё — случайный пазл на случайную сложность", подпись: "«несобранных пазлов: N» или «всё собрано — играем снова!»" }
    кнопка_продолжить { когда: "есть незаконченная сессия", вид: "превью картинки + «собрано X из Y» + «не потеряй свои кусочки!»" }
    кнопка_альбом  { когда: "всегда (v1.5)", вид: "белая с янтарной рамкой, 📔", подпись: "наклеек: N из 96 · собирай новые!" }
    миры       : "8 карточек: иконка, название, «3 пазла · собрано X/3»"
    низ        : "совет родителям про звук + подпись версии"
  }

  мир {
    назад      : "кнопка «← Миры»"
    заголовок  : "иконка мира, название, подзаголовок"
    пазлы      : "3 карточки: живое превью, галочка если собран, бейджи сложностей 6/12/24/48 (золотые — собранные)"
    для_родителей: "тихая ссылка «Сбросить прогресс» с двойным подтверждением"
  }

  альбом {
    назад      : "кнопка «← Меню»"
    счётчик    : "«Наклеек: N из 96»; если 0 — подсказка «Собери первый пазл!»"
    разделы    : "8 миров; у каждого счётчик наклеек (например «Гонки 1/12»)"
    строка_пазла { превью: "цветное, если есть наклейка; серый силуэт с замком, если нет", слоты: "4 наклейки 6/12/24/48: жёлтая с звездой — собрана, пунктир «?» — впереди", кнопка: "🔊 история пазла (только у собранных)" }
    данные     : "наклейки вычисляются из прогресса — отдельного хранилища нет, потерять невозможно"
  }

  игра {
    панель     : "«← Меню» | сложности 6/12/24/48 | «Показать/Скрыть образец» | звук вкл/выкл | «Перемешать»"
    строка     : "иконка мира + название пазла | «Собрано N из M» + зелёная полоска прогресса"
    поле       : "бледный образец картинки под деталями (прозрачность 24%), детали поверх"
    поднос     : "полоса снизу, высота = ровно одна деталь с ушками + воздух; детали рассыпаны по ней"
    победа {
      вид     : "затемнение ТОЛЬКО над полем (поднос не трогаем), конфетти, фанфары"
      открытка: "«Ура! Пазл собран!» + история пазла + познавательный факт"
      наклейка: "(v1.5) если сложность собрана впервые — плашка «Новая наклейка!» с превью и анимацией; повторно — не показывается"
      кнопки  : [ "Послушать ещё раз", "Собрать ещё раз", "Посмотреть альбом (v1.5)", "← Выбрать новый пазл" ]
    }
    правило    : "экраны меняются без перезагрузки страницы; всё поле+поднос+шапка влезают в экран без прокрутки"
  }
}


# ------------------------------ 4. МЕХАНИКА СБОРКИ ------------------------------

механика {
  сложности [
    { кусочков: 6,  сетка: "3×2", подпись: "Начинаем" },
    { кусочков: 12, сетка: "4×3", подпись: "Умею" },
    { кусочков: 24, сетка: "6×4", подпись: "Мастер" },
    { кусочков: 48, сетка: "8×6", подпись: "Эксперт" },
  ]

  деталь {
    форма  : "классический джигсо: ушки и выемки по кривым Безье, размер ушка ~9–11% стороны"
    края   : "у рамки пазла края ровные"
    контур : "тёмный внутри (виден даже на белом участке картинки) + светлая окантовка снаружи + мягкая тень под ушками"
    запас  : "запас под ушки = 32% меньшей стороны детали"
  }

  магнит {
    допуск: "прилипание, если деталь ближе max(22px; 28% меньшей стороны), потолок — 30% поля, минимум 24px"
    v1_4  : "на 6 кусочках допуск 40% меньшей стороны (было 28%) — сделано, проверено; 12/24/48 не тронуты"
  }

  поднос {
    высота      : "максимум(110px; поле × (1/строк + 0.64 × меньшая доля) + 16px) — сама растёт для крупных деталей"
    заход_на_поле: "не больше min(25% детали, 40px) — полка выглядит полной, картинка не закрыта"
    размер_поля : "решается уравнением «шапка + поле + поднос = экран» с резервом 44px, итог 240–640px; на телефоне и планшете всё влезает без прокрутки (проверено: перелив 0)"
  }

  жесты {
    управление: "палец или мышь (Pointer Events), страница не скроллится во время переноски"
    захват    : "деталь берётся, только если палец попал по её настоящей форме (проверка по контуру); берётся верхняя"
    при_подъёме: "деталь поднимается наверх по слоям"
    прилипание: "деталь сама встаёт на место + щелчок + искры (7 штук) + вибрация 28 мс"
  }

  рассыпание {
    при_старте: "детали падают в поднос со звуком «вжух», с минимальной дистанцией между соседями (50% детали), до 30 попыток на деталь"
    перемешать: "кнопка рассыпает всё заново в поднос, счётчик сбрасывается"
  }

  подсказка {
    образец: "бледная картинка-образец прямо на поле под деталями, кнопка «Показать/Скрыть»"
  }

  озвучка {
    задание: "при входе в пазл инструкция читается вслух — 1 раз на пазл за визит (смена сложности не повторяет)"
    победа : "«Молодец! Ты собрал пазл {название}!» + история пазла"
  }

  победа {
    конфетти: 110
    запись  : "пазл помечается собранным, сложность добавляется в «уровни», сессия удаляется"
  }
}


# ------------------------------ 5. ЗВУК И ГОЛОС ------------------------------

звук_и_голос {
  звуки [
    { имя: "pick",   когда: "взяли деталь" },
    { имя: "drop",   когда: "отпустили мимо" },
    { имя: "snap",   когда: "деталь встала на место" },
    { имя: "win",    когда: "пазл собран (фанфары)" },
    { имя: "button", когда: "нажата кнопка" },
    { имя: "whoosh", когда: "рассыпание деталей" },
    { имя: "star",   когда: "наведение на карточки (звёздочка)" },
  ]
  музыка      { статус: "ГОТОВО В КОДЕ, НЕ ВКЛЮЧЕНО", суть: "нежная мелодия на петле — включим отдельным решением" }
  голос {
    движок    : "SpeechSynthesis браузера"
    язык      : "ru-RU, темп 0.95 (чуть медленнее), тон 1.1 (чуть выше — детский оттенок)"
    выбор_голоса: "список голосов кэшируется и обновляется по событию voiceschanged; для браузеров без события — опрос 5 секунд; предпочитаются локальные голоса (не зависят от интернета)"
    фолбэк    : "если русского голоса в системе нет — текст всё равно произносится дефолтным голосом (лучше тишины)"
  }
  приветствие { статус: "ГОТОВО В КОДЕ, НЕ ВКЛЮЧЕНО", суть: "«Привет! Выбирай мир и собирай пазлы!» при первом входе" }
  тишина      : "один переключатель звука глушит сразу и эффекты, и голос; выбор запоминается"
}


# ------------------------------ 6. СОХРАНЕНИЕ ------------------------------

сохранение {
  хранилище: "localStorage устройства — прогресс у каждого игрока свой, сервер ничего не хранит"
  ключи {
    прогресс: { ключ: "mkpz:progress:v1",  содержимое: "по каждому пазлу: собран? + какие сложности пройдены [6,12,24,48]" }
    сессии  : { ключ: "mkpz:session:v1",   содержимое: "незаконченные сборки, хранятся последние 6" }
    настройки: { ключ: "mkpz:settings:v1", содержимое: "звук вкл/выкл" }
    версия  : { ключ: "mkpz:lastVersion",  содержимое: "для плашки «Появилось обновление!»" }
  }
  сессия {
    позиции: "координаты в долях поля (0..1) — после поворота экрана или ресайза ничего не съезжает"
    зоны   : "у каждой детали зона: 'b' — на поле, 't' — в подносе"
    ход    : "сохраняется после каждого отпущенного пальца"
  }
  сброс: "кнопка в каждом мире, скрыта в маленькую серую ссылку, с подтверждением «Точно сбросить все галочки?»"
}


# ------------------------------ 7. МИРЫ И ПАЗЛЫ (8 миров · 24 пазла) ------------------------------

# У каждого пазла: задание (озвучивается при входе), история и факт (экран победы).

мир {
  id: "train"
  название: "Поезд"
  подзаголовок: "Паровозики и поезда"
  цвет: "#e8590c"

  пазл "train-steam" {
    имя: "Паровозик"  сцена: "steam-locomotive"
    задание: "Собери паровозик! Поставь детали на свои места."
    история: "Пых-пых! Старый добрый паровозик снова едет по рельсам. Он везёт пассажиров к морю и весь путь весело трубит в гудок: ту-ту!"
    факт: "Паровоз едет за счёт пара: вода в котле закипает, и пар толкает колёса вперёд!"
  }
  пазл "train-fast" {
    имя: "Скоростной поезд"  сцена: "speed-train"
    задание: "Собери скоростной поезд! Найди место для всех деталей."
    история: "Ух, быстрее ветра! Скоростной поезд мчится между горами. Пассажиры смотрят в окно, а за окном мелькают поля и тоннели!"
    факт: "Самый быстрый поезд в мире разгоняется быстрее гоночного автомобиля — до 600 километров в час!"
  }
  пазл "train-cargo" {
    имя: "Грузовой поезд"  сцена: "cargo-train"
    задание: "Собери грузовой поезд! Поставь тяжёлые вагоны."
    история: "Тяжело! Грузовой поезд везёт брёвна и ящики через всю страну. Много вагонов — много работы, но мощный локомотив справится!"
    факт: "Самый длинный грузовой поезд тянул за собой 682 вагона — почти как маленький город!"
  }
}

мир {
  id: "race"
  название: "Гонки"
  подзаголовок: "Быстрые машины и ралли"
  цвет: "#e03131"

  пазл "race-formula" {
    имя: "Формула"  сцена: "formula-car"
    задание: "Собери гоночную формулу! Она самая быстрая."
    история: "Вжжух! Красный болид сходит с места, только мигнул зелёный свет! Ветер свистит в шлеме пилота, мотор поёт на всю трассу — а на финише уже машет клетчатый флаг!"
    факт: "Болид Формулы-1 разгоняется до 350 километров в час — быстрее, чем гепард!"
  }
  пазл "race-rally" {
    имя: "Ралли-джип"  сцена: "rally-car"
    задание: "Собери ралли-джип! Он летит по грязной дороге."
    история: "Бр-р-р! Синий джип прыгает на кочках, обгоняет всех на повороте и летит через трамплин! Из-под колёс летят брызги грязи, а люстра на крыше освещает путь!"
    факт: "В ралли машину ведут двое: пилот рулит, а штурман читает карту вслух!"
  }
  пазл "race-kart" {
    имя: "Картинг"  сцена: "kart"
    задание: "Собери картинг! Маленькая, а шустрая!"
    история: "Вжик-вжик! Маленький карт юрко ныряет в повороты — все большие машины остались позади! Пилот в розовом шлеме смеётся: гонка — это весело!"
    факт: "Все великие гонщики начинали с карта — маленькой машины для больших побед!"
  }
}

мир {
  id: "construction"
  название: "Стройка"
  подзаголовок: "Строим и копаем"
  цвет: "#f08c00"

  пазл "build-house" {
    имя: "Стройка дома"  сцена: "house-build"
    задание: "Построй дом! Поставь стены и крышу."
    история: "Тук-тук, стук-стук! Дом почти готов: стены стоят, крыша красная, окошко блестит. Скоро сюда переедет весёлая семья!"
    факт: "Краны на стройке выше десяти слонов, поставленных друг на друга!"
  }
  пазл "build-excavator" {
    имя: "Экскаватор"  сцена: "excavator"
    задание: "Собери экскаватор! Он копает землю."
    история: "Р-р-р! Жёлтый экскаватор копает большой котлован. Черпак зачерпнул полную землю — и сразу выгрузил в кузов грузовика!"
    факт: "Один экскаватор за день копает столько земли, сколько тысяча человек лопатами!"
  }
  пазл "build-crane" {
    имя: "Кран и блоки"  сцена: "crane-blocks"
    задание: "Поставь кран и подними блоки на высоту."
    история: "Вжжжух! Подъёмный кран поднимает блоки на самый верх небоскрёба. Аккуратно, не спеша — и новый этаж готов!"
    факт: "Строительный кран сам растёт вместе с домом — строители добавляют ему новые секции!"
  }
}

мир {
  id: "earth"
  название: "Земля"
  подзаголовок: "Наша планета"
  цвет: "#2f9e44"

  пазл "earth-planet" {
    имя: "Планета"  сцена: "planet-earth"
    задание: "Собери планету Земля!"
    история: "Вот она — наша Земля! Голубые океаны, зелёные леса, белые облака. Наш дом летит в космосе и кружится вокруг солнца."
    факт: "Земля — единственная известная планета, где живут коты, собаки, деревья... и ты!"
  }
  пазл "earth-volcano" {
    имя: "Вулкан"  сцена: "volcano"
    задание: "Собери вулкан! Он проснулся."
    история: "Гром! Вулкан проснулся и пускает дым. Из жерла течёт тёплая оранжевая лава, а вокруг всё светится от заката."
    факт: "Лава — это расплавленный камень. Когда она остывает, становится твёрдой, как чёрный хлеб!"
  }
  пазл "earth-mountains" {
    имя: "Горы"  сцена: "mountains"
    задание: "Собери горы! Высокие вершины и снег."
    история: "Высоко-высоко! Горы упираются вершинами в облака. На макушках лежит снег, а внизу шумит зелёный лес."
    факт: "Самая высокая гора — Эверест. На её вершину поместилось бы семь Эйфелевых башен, поставленных одна на другую!"
  }
}

