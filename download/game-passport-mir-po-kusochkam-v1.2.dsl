# ------------------------------ 8. ИСТОРИЯ ВЕРСИЙ ------------------------------

история_версий {
  "1.0" { статус: ГОТОВО, что: "старт игры: пазлы, механика, звуки, конфетти, озвучка" }
  "1.1" { статус: ГОТОВО, что: "сохранение незаконченной сборки + кнопка «Продолжить» + плашка «Появилось обновление!»" }
  "1.2" { статус: ГОТОВО, что: "мир «Гонки» (3 машины) + поднос для деталей: высота от размера детали, поле+поднос всегда влезают в экран" }
  "1.3" { статус: ГОТОВО, что: "голос с фолбэком (voiceschanged, кэш, русский текст даже без русского голоса) + кнопка «Играть!» (случайный несобранный пазл) + превью в «Продолжить» + поле влезает в экран без пустого скролла (резерв 44px)" }
  "1.4" { статус: ГОТОВО, что: "магнит крупнее на 6 кусочках: допуск 40% размера кусочка (было 28%); 12/24/48 не тронуты; проверено дифференциальным тестом: промах 38px на 6 кусочках прилипает, на 12 — нет" }
  "1.5" { статус: ГОТОВО, что: "наклейки-альбом: экран с 96 наклейками (24 пазла × 4 сложности), силуэты-замки у несобранных, кнопка 🔊 с историей; на победном экране «Новая наклейка!» при первом сборе сложности + кнопка «Посмотреть альбом»; данные — из прогресса, без нового хранилища" }
  "1.6" { статус: ГОТОВО, что: "звуки и музыка: фоновая мелодия подключена (старт после первого касания, пауза при сворачивании вкладки), отдельная кнопка 🎵 в игре и на главной, кнопки 🔊/🎵 на главном экране; настройка music сохраняется" }
  "1.7" { статус: ГОТОВО, что: "ожившие картинки: на победном экране собранная картинка оживает — лучи солнца вращаются (позиции из фонов сцены), звёзды мерцают ровно на нарисованных звёздочках, падающая звезда, пузырьки, бабочки, искры вулкана, пылинки в комнате; ~30 кадров/с, альбом остался статичным" }
  "1.8" { статус: ГОТОВО, что: "родительская панель (вход-вопрос с двузначными числами): статистика по мирам, звук/музыка, напоминание об отдыхе Выкл/15/20/30 мин, скачивание PNG собранных картинок, сброс прогресса; напоминание: после лимита солнышко «Пора отдохнуть! Потяни ручки, похлопай глазками» + экран плавно затухает за 60с, кнопки «Мы отдохнули» и «Ещё 5 минут»; кнопка «Сохранить картинку» на победном экране" }
  "1.9" { статус: ГОТОВО, что: "полный офлайн (PWA): manifest + service worker (страницы — сеть/офлайн-кэш, статика — кэш с фоновым обновлением, /api не кэшируется), иконки 192/512/maskable, установка на главный экран; проверено настоящим отключением сети — игра открывается и играется офлайн, пазл собирается, победа работает" }
}


